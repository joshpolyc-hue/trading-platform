* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: linear-gradient(180deg, #06131f 0%, #0b1e2d 100%);
  color: #eef6ff;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  border: none;
  border-radius: 10px;
  cursor: pointer;
}

.page-shell,
.dashboard-shell,
.training-shell {
  min-height: 100vh;
  padding: 24px 64px 64px;
}

.topbar,
.dashboard-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  max-width: 1280px;
  margin: 0 auto 48px;
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.brand-mark {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: linear-gradient(135deg, #68d391, #0ea5e9);
  color: #06131f;
  font-weight: 800;
}

.nav {
  display: flex;
  align-items: center;
  gap: 24px;
  color: #c5d7eb;
}

.primary-button,
.secondary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: 0.2s ease;
}

.primary-button {
  background: linear-gradient(135deg, #34d399, #0ea5e9);
  color: #04161d;
  padding: 12px 18px;
  font-weight: 700;
}

.secondary-button {
  background: rgba(148, 163, 184, 0.12);
  color: #f5f9ff;
  padding: 12px 18px;
  border: 1px solid rgba(148, 163, 184, 0.35);
}

.secondary-button.small {
  padding: 8px 12px;
  font-size: 0.9rem;
}

.hero {
  max-width: 1280px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 48px;
  align-items: center;
}

.hero-copy h1,
.training-hero h1 {
  margin: 0;
  font-size: clamp(2.8rem, 6vw, 5rem);
  line-height: 1.04;
  letter-spacing: -0.06em;
}

.hero-copy p {
  max-width: 700px;
  color: #d7e6f7;
  font-size: 1.1rem;
  line-height: 1.7;
  margin: 20px 0 30px;
}

.eyebrow {
  display: inline-block;
  margin-bottom: 14px;
  padding: 8px 12px;
  border-radius: 999px;
  background: rgba(14, 165, 233, 0.12);
  color: #7dd3fc;
  font-size: 0.8rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.hero-actions {
  display: flex;
  gap: 14px;
  margin-bottom: 28px;
}

.metric-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(120px, 1fr));
  gap: 18px;
}

.metric-box,
.stat-card,
.panel-card,
.feature-card,
.lesson-card {
  background: rgba(15, 23, 42, 0.68);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 18px;
  box-shadow: 0 15px 30px rgba(15, 23, 42, 0.2);
}

.metric-box {
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.metric-box strong,
.stat-card strong,
.balance-block strong {
  font-size: 1.5rem;
}

.metric-box span,
.stat-card span,
.balance-block span {
  color: #c7d4ea;
  font-size: 0.8rem;
}

.hero-panel {
  background: rgba(9, 20, 31, 0.92);
  border: 1px solid rgba(148, 163, 184, 0.25);
  border-radius: 24px;
  padding: 20px;
}

.panel-header,
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 18px;
}

.alive-dot {
  background: rgba(52, 211, 153, 0.16);
  border: 1px solid rgba(52, 211, 153, 0.38);
  color: #6ee7b7;
  border-radius: 999px;
  padding: 6px 10px;
  font-size: 0.75rem;
}

.ticker-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.ticker-item {
  display: grid;
  grid-template-columns: 1fr auto auto;
  gap: 14px;
  align-items: center;
  padding: 12px 14px;
  background: rgba(15, 23, 42, 0.8);
  border-radius: 14px;
}

.ticker-item span,
.position-item span,
.watch-row span,
.check-list li,
.lesson-card p,
.feature-card p {
  color: #cfe0f6;
}

.up {
  color: #6ee7b7;
}

.down {
  color: #fca5a5;
}

.mini-chart {
  display: flex;
  align-items: end;
  gap: 10px;
  height: 160px;
  margin-top: 24px;
  border-radius: 16px;
  background: linear-gradient(180deg, rgba(15, 118, 110, 0.08), rgba(14, 165, 233, 0.08));
  padding: 18px 12px 8px;
}

.bar {
  display: block;
  width: 100%;
  border-radius: 10px 10px 0 0;
  background: linear-gradient(180deg, #34d399, #0ea5e9);
}

.b1 { height: 30%; }
.b2 { height: 42%; }
.b3 { height: 50%; }
.b4 { height: 60%; }
.b5 { height: 75%; }
.b6 { height: 82%; }
.b7 { height: 88%; }
.b8 { height: 97%; }

.feature-section {
  max-width: 1280px;
  margin: 96px auto 0;
}

.section-heading {
  margin-bottom: 32px;
}

.section-heading h2 {
  margin: 0;
  font-size: clamp(2rem, 4vw, 3rem);
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(220px, 1fr));
  gap: 22px;
}

.feature-card {
  padding: 24px 22px;
}

.feature-icon {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  background: rgba(52, 211, 153, 0.14);
  color: #6ee7b7;
  margin-bottom: 18px;
  font-weight: 700;
}

.feature-card h3,
.lesson-card h3,
.panel-card h3 {
  margin-top: 0;
  margin-bottom: 12px;
  font-size: 1.2rem;
}

.dashboard-grid,
.trading-layout,
.training-grid {
  max-width: 1280px;
  margin: 0 auto;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: 340px 1fr;
  gap: 24px;
}

.side-panel,
.main-panel {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.panel-card {
  padding: 22px;
}

.balance-block {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 12px;
}

.risk-meter {
  width: 100%;
  height: 14px;
  background: rgba(148, 163, 184, 0.16);
  border-radius: 999px;
  overflow: hidden;
  margin: 16px 0 8px;
}

.risk-fill {
  width: 32%;
  height: 100%;
  background: linear-gradient(90deg, #34d399, #fbbf24, #f87171);
}

.check-list {
  padding-left: 18px;
  margin: 16px 0 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.stats-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(150px, 1fr));
  gap: 18px;
}

.stat-card {
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.content-grid {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 22px;
}

.wide-card {
  min-height: 320px;
}

.watchlist,
.position-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.watch-row,
.position-item,
.trade-row {
  display: grid;
  grid-template-columns: 1fr auto auto;
  gap: 14px;
  align-items: center;
  background: rgba(15, 23, 42, 0.9);
  border-radius: 12px;
  padding: 12px 14px;
}

.position-item {
  grid-template-columns: 1fr 1fr 1fr;
}

.position-item strong,
.watch-row strong {
  display: block;
  margin-bottom: 4px;
}

.training-hero {
  max-width: 1280px;
  margin: 0 auto 32px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
}

.training-grid {
  display: grid;
  grid-template-columns: 1.3fr 0.7fr;
  gap: 26px;
}

.lesson-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(220px, 1fr));
  gap: 20px;
}

.lesson-card {
  padding: 22px;
}

.lesson-badge {
  display: inline-block;
  margin-bottom: 12px;
  background: rgba(14, 165, 233, 0.12);
  color: #7dd3fc;
  border-radius: 999px;
  padding: 7px 10px;
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.training-panel {
  min-height: 100%;
}

.trading-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  margin-bottom: 24px;
}

.trade-form {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.trade-form label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: #dfeaf8;
}

.trade-form input,
.trade-form select,
.trade-form textarea {
  border: 1px solid rgba(148, 163, 184, 0.24);
  background: rgba(15, 23, 42, 0.7);
  color: #eef6ff;
  border-radius: 10px;
  padding: 12px 14px;
}

.trade-history-block {
  max-width: 1280px;
  margin: 0 auto;
}

.trade-history-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.trade-row {
  grid-template-columns: 1fr 1fr 1fr 1fr 2fr;
}

@media (max-width: 1000px) {
  .page-shell,
  .dashboard-shell,
  .training-shell {
    padding-left: 24px;
    padding-right: 24px;
  }

  .hero,
  .dashboard-grid,
  .content-grid,
  .training-grid,
  .trading-layout {
    grid-template-columns: 1fr;
  }

  .feature-grid,
  .lesson-list,
  .stats-row,
  .metric-row {
    grid-template-columns: repeat(2, minmax(200px, 1fr));
  }

  .topbar,
  .dashboard-topbar,
  .training-hero {
    flex-wrap: wrap;
  }
}

@media (max-width: 640px) {
  .feature-grid,
  .lesson-list,
  .stats-row,
  .metric-row {
    grid-template-columns: 1fr;
  }

  .nav {
    gap: 12px;
    font-size: 0.85rem;
  }

  .hero-copy h1,
  .training-hero h1 {
    font-size: 2.5rem;
  }
}
